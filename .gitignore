# Dependencies
**/node_modules/

# Database
*.db
*.db-shm
*.db-wal
data/*.db.bak-*

# Uploads (file transfer)
server/uploads/

# Screenshots
teammcp-screenshots/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Environment (all directories)
**/.env
**/.env.local

# Claude Code / MCP config (may contain API keys)
.claude.json
.claude/
.mcp.json

# Test scripts
test-notify.mjs

# Logs
*.log

# WeChat token (contains bot credentials)
wechat-token.json

# NPM tarball
*.tgz

# Agent directories (local only) — anchor to repo root so this doesn't
# also swallow dashboard/src/components/agents/.
/agents/

# Test scripts
scripts/test-sdk-agent.mjs
*.weixin-token.json

# OAuth credentials (real tokens)
oauth-credentials.json

# Credential-profile encryption key (AES-256-GCM, auto-generated)
.cred-key
**/.cred-key

# Local secret bootstrap (MEMORY_LLM_KEY, etc.) — dot-sourced by start-*.ps1
secrets.local.ps1
secrets.local.sh

# Server backups (local only)
server-backup-*/

# Local test scripts
test-permission*.mjs
test-wechat-approval.mjs

# Runtime error logs (stderr captures, soak runs, T1 boot probes)
*.err

# Local-only sibling dev dir
teammcp-code-dev/

# Pre-edit backup snapshots (server/_backup_YYYYMMDD/, *.bak-pre-*)
server/_backup_*/
*.bak-pre-*

# Local data dir (DB + state). The *.db rules above already cover the binary
# files, but the dir itself can also accumulate transient artifacts.
/data/
/logs/

# Remote deploy probe scripts (contain SSH creds when run)
_remote-*.py
_teammcp-src.tar.gz
